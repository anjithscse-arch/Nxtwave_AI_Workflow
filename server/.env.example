# ==============================================================================
# CampusMind Server - Environment Variable Configuration Template
# ==============================================================================
# Copy this file to `server/.env` and update values for your environment.

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret
JWT_EXPIRES_IN=7d

# Database Configuration
# Provide a MongoDB Atlas connection string, or leave blank for embedded in-memory fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campusmind?retryWrites=true&w=majority

# Background Job Queue
# Provide a Redis connection URL (e.g. redis://localhost:6379), or leave blank for in-memory queue fallback
REDIS_URL=redis://localhost:6379

# Google Generative AI (Gemini) SDK
# Provide a Google AI Studio API key, or leave blank for deterministic fallback
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# RAG Pipeline & Guardrail Parameters
SIMILARITY_THRESHOLD=0.35
TOP_K=5
GUARDRAIL_CONFIDENCE_THRESHOLD=0.70
