# ==============================================================================
# CAMPUSMIND PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=production
# Set CLIENT_URL to your deployed frontend domain (e.g., https://campusmind.vercel.app)
CLIENT_URL=https://campusmind.yourdomain.com

# Authentication
# IMPORTANT: Generate a strong 64+ char random secret in production (e.g., openssl rand -base64 48)
JWT_SECRET=your-production-high-entropy-jwt-secret-key-change-immediately
JWT_EXPIRES_IN=7d

# Database & Vector Search
# MUST point to a real MongoDB Atlas Cluster with Atlas Vector Search index configured
# Example: mongodb+srv://dbAdmin:<password>@campusmind-cluster.mongodb.net/campusmind?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/campusmind?retryWrites=true&w=majority

# Background Job Queue (Redis)
# Example: rediss://default:<password>@<host>:<port> (e.g. Upstash Redis, Redis Cloud)
REDIS_URL=rediss://default:your-redis-password@your-redis-host:6379

# Google Generative AI (Gemini) SDK
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourProductionGeminiApiKeyHere
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# RAG Pipeline Thresholds & Cutoffs
SIMILARITY_THRESHOLD=0.35
TOP_K=5
GUARDRAIL_CONFIDENCE_THRESHOLD=0.70
